{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Microstock AI Studio Pro",
  "version": "2.5.0",
  "identifier": "com.microstock.studio",
  "build": {
    "frontendDist": "../../microstock/web",
    "devUrl": "http://127.0.0.1:8505"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Microstock AI Studio Pro",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
